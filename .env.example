# Copy to .env for local development. Never commit the real key.

# Base URL of the My-JSON-Server deployment the dev proxy forwards to.
API_TARGET=https://my-json-server-gbdv.onrender.com

# Shared secret the API requires for POST/PUT/PATCH/DELETE. Take it from the
# Render dashboard (Environment tab of the my-json-server service).
#
# No VITE_ prefix on purpose: only vite.config.js reads it, and it is attached
# to proxied requests server-side. Renaming it to VITE_API_KEY would publish
# the key in the browser bundle.
API_KEY=
